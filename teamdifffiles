#!/bin/zsh
# teamdifffiles - Show changed files grouped by CODEOWNERS teams and categorized by code vs tests

from_ref=${1:-origin/main}
to_ref=${2:---staged}

emulate -L zsh
setopt extended_glob

# Constants
UNOWNED_TEAM="(unowned)"

# Ownership and classification are shared with teamdiffstats / diffstats via the
# library, so the team headings here match the required-reviewer list on the PR:
# last-matching-rule-wins, every owner on the winning rule credited, gitignore
# path-component matching, owner-less rules remove ownership.
#
# The parser this replaced took only the FIRST owner on a rule, skipped rules
# not starting with `/`, and picked the deepest match rather than the last one.
_lib=${0:A:h}/lib/changestats.zsh
if [[ ! -r $_lib ]]; then
    print -u2 "teamdifffiles: missing library at $_lib"
    exit 1
fi
source $_lib

codeowners_load .github/CODEOWNERS

# Process git diff output
declare -A team_code_files
declare -A team_test_files
declare -A team_gen_files
declare -A seen_team

_add_file() {  # _add_file <team> <kind> <file>
    seen_team[$1]=1
    case $2 in
        (test)      team_test_files[$1]+="$3"$'\n' ;;
        (generated) team_gen_files[$1]+="$3"$'\n' ;;
        (*)         team_code_files[$1]+="$3"$'\n' ;;
    esac
}

typeset -i n_files=0
while read -r file; do
    # Skip empty lines
    [[ -z $file ]] && continue
    (( n_files++ ))

    kind=$(classify_path $file)
    owners=($(codeowners_for $file))

    # A file with several owners is listed under each of them, because each one
    # is separately on the hook for reviewing it.
    if (( ${#owners} == 0 )); then
        _add_file $UNOWNED_TEAM $kind $file
    else
        for owner in $owners; do
            _add_file ${owner#@} $kind $file
        done
    fi
done < <(git diff --name-only "$from_ref" "$to_ref")

(( n_files )) || exit 0

_count_files() { print -rn -- "$1" | grep -c '[^[:space:]]' }

# Sort teams by file count descending, name ascending for a stable tie-break.
# The old version keyed an associative array by "count:team", which collapsed
# teams that happened to share a count.
sorted_rows=()
for team in "${(@k)seen_team}"; do
    [[ $team == $UNOWNED_TEAM ]] && continue
    total_files=$((
        $(_count_files "${team_code_files[$team]}") +
        $(_count_files "${team_test_files[$team]}") +
        $(_count_files "${team_gen_files[$team]}")
    ))
    sorted_rows+=("$total_files	$team")
done
sorted_rows=(${(f)"$(print -rl -- $sorted_rows | sort -t$'\t' -k1,1nr -k2,2)"})
sorted_teams=()
for row in $sorted_rows; do
    [[ -n $row ]] && sorted_teams+=("${row#*$'\t'}")
done
(( ${+seen_team[$UNOWNED_TEAM]} )) && sorted_teams+=($UNOWNED_TEAM)

_print_section() {  # _print_section <label> <blob>
    [[ -n $2 ]] || return 0
    print -r -- "$1 ($(_count_files "$2")):"
    print -rn -- "$2" | sed 's/^/  /'
}

# Print results
typeset -i first=1
for team in "${sorted_teams[@]}"; do
    (( first )) || print -r -- ""
    first=0

    header="Team: $team"
    print -r -- "$header"
    print -r -- "${(l:${#header}::-:)}"

    _print_section "Code Files"      "${team_code_files[$team]}"
    _print_section "Test Files"      "${team_test_files[$team]}"
    _print_section "Generated Files" "${team_gen_files[$team]}"
done

if (( ${#sorted_teams} > 1 )); then
    print -r -- ""
    print -r -- "A file with several owners is listed under each of them."
fi

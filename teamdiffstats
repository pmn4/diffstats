#!/bin/zsh
# teamdiffstats - Visual git diff statistics by team
# Shows code and test changes with visual bars, grouped by team

from_ref=${1:-origin/main}
to_ref=${2:---staged}

# Constants
UNOWNED_TEAM="(unowned)"

# Read CODEOWNERS file and build team mapping
declare -A team_files
declare -a sorted_patterns
current_team=""

while IFS= read -r line; do
    # Skip comments and empty lines
    [[ $line =~ ^#.*$ ]] && continue
    [[ -z $line ]] && continue

    # Check if line starts with a path pattern
    if [[ $line =~ ^/ ]]; then
        # Extract path pattern and team
        path_pattern=$(echo "$line" | awk '{print $1}')
        team=$(echo "$line" | awk '{print $2}')
        
        # Remove @ symbol from team name
        team=${team#@}
        
        # Remove leading slash from path pattern
        path_pattern=${path_pattern#/}
        
        # Store the mapping
        team_files[$path_pattern]=$team
        
        # Add pattern to array for sorting
        sorted_patterns+=("$path_pattern")
    fi
done < .github/CODEOWNERS

# Sort patterns by depth (number of path components) in descending order
# this allows us to use a first-match-wins approach
sorted_patterns=($(for pattern in "${sorted_patterns[@]}"; do
    depth=$(echo "$pattern" | tr -cd '/' | wc -c)
    echo "$depth:$pattern"
done | sort -nr -t: -k1 | cut -d: -f2))

# Function to determine team for a file
get_team() {
    local file=$1
    local team=$UNOWNED_TEAM
    
    # Convert glob patterns to regex patterns
    for pattern in "${sorted_patterns[@]}"; do
        # Escape special regex characters
        regex_pattern=${pattern//\*/.*}
        regex_pattern=${regex_pattern//\?/.}
        regex_pattern=${regex_pattern//\//\\/}
        
        if [[ $file =~ ^$regex_pattern ]]; then
            team=${team_files[$pattern]}
            break
        fi
    done
    
    echo "$team"
}

# Process git diff output
declare -A team_stats
declare -A team_test_stats

# Use process substitution to handle the pipe in zsh
while read -r added deleted file; do
    # Skip empty lines
    [[ -z $file ]] && continue
    
    # Get team for this file
    team=$(get_team "$file")
    
    # Initialize team stats if not exists
    [[ -z ${team_stats[$team]} ]] && team_stats[$team]="0 0"
    [[ -z ${team_test_stats[$team]} ]] && team_test_stats[$team]="0 0"
    
    # Split current stats
    read -r code_add code_del <<< "${team_stats[$team]}"
    read -r test_add test_del <<< "${team_test_stats[$team]}"
    
    # Update stats based on file type
    if [[ $file =~ (\.(test|jest|stories|cy)\.|test_/) ]]; then
        test_add=$((test_add + added))
        test_del=$((test_del + deleted))
        team_test_stats[$team]="$test_add $test_del"
    else
        code_add=$((code_add + added))
        code_del=$((code_del + deleted))
        team_stats[$team]="$code_add $code_del"
    fi
done < <(git diff "$from_ref" "$to_ref" --numstat)

# Calculate max values for scaling and column widths
max_team_length=0
max_code_add_length=0
max_code_del_length=0
max_test_add_length=0
max_test_del_length=0

# First pass to get max lengths of actual formatted strings
for team in "${(@k)team_stats}"; do
    read -r code_add code_del <<< "${team_stats[$team]}"
    read -r test_add test_del <<< "${team_test_stats[$team]}"
    
    # Format numbers temporarily to get their actual string lengths
    code_add_str=$(printf "%+d" $code_add)
    code_del_str=$(printf "%d" $((-$code_del)))
    test_add_str=$(printf "%+d" $test_add)
    test_del_str=$(printf "%d" $((-$test_del)))
    
    # Update max lengths based on actual formatted strings
    [[ ${#team} -gt $max_team_length ]] && max_team_length=${#team}
    [[ ${#code_add_str} -gt $max_code_add_length ]] && max_code_add_length=${#code_add_str}
    [[ ${#code_del_str} -gt $max_code_del_length ]] && max_code_del_length=${#code_del_str}
    [[ ${#test_add_str} -gt $max_test_add_length ]] && max_test_add_length=${#code_add_str}
    [[ ${#test_del_str} -gt $max_test_del_length ]] && max_test_del_length=${#code_del_str}
done

# Calculate column widths
team_width=$((max_team_length + 2))
code_width=$((max_code_add_length + max_code_del_length + 4))  # +4 for "(, )" and spacing
test_width=$((max_test_add_length + max_test_del_length + 4))

# Create array of teams sorted by total code changes, with unowned at the end
sorted_teams=()
unowned_team=""
for team in "${(@k)team_stats}"; do
    read -r code_add code_del <<< "${team_stats[$team]}"
    total_changes=$((code_add + code_del))
    if [[ $team == $UNOWNED_TEAM ]]; then
        unowned_team="$total_changes:$team"
    else
        sorted_teams+=("$total_changes:$team")
    fi
done
sorted_teams=(${(On)sorted_teams})  # Sort numerically in descending order
sorted_teams=(${sorted_teams#*:})   # Remove the numeric prefix
if [[ -n $unowned_team ]]; then
    sorted_teams+=($UNOWNED_TEAM)  # Add unowned at the end
fi

# Print header
printf "%-${team_width}s %-${code_width}s %-${test_width}s\n" \
    "Team" "Code" "Tests"
printf "%-${team_width}s %-${code_width}s %-${test_width}s\n" \
    "$(printf "%${max_team_length}s" | tr ' ' '-')" \
    "$(printf "%${code_width}s" | tr ' ' '-')" \
    "$(printf "%${test_width}s" | tr ' ' '-')"

# Print stats for each team
for team in "${sorted_teams[@]}"; do
    read -r code_add code_del <<< "${team_stats[$team]}"
    read -r test_add test_del <<< "${team_test_stats[$team]}"
    
    # Format numbers with consistent spacing and right-aligned deletions
    code_add_str=$(printf "%+${max_code_add_length}d" $code_add)
    code_del_str=$(printf "%${max_code_del_length}d" $((-$code_del)))
    test_add_str=$(printf "%+${max_test_add_length}d" $test_add)
    test_del_str=$(printf "%${max_test_del_length}d" $((-$test_del)))
    
    # Print team stats with parentheses and commas
    printf "%-${team_width}s (%s, %s) (%s, %s)\n" \
        "$team" \
        "$code_add_str" \
        "$code_del_str" \
        "$test_add_str" \
        "$test_del_str"
done

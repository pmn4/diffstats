#!/bin/zsh
# teamdiffstats - git diff statistics grouped by CODEOWNERS team.
#
# PURPOSE
# When GitHub lists a team as a required reviewer on a PR, that team should be
# able to find its own row here and see how much of the diff belongs to it.
# So the set of team rows is built to equal GitHub's required-reviewer set:
# last-matching-rule-wins, every owner on the winning rule credited, gitignore
# path-component matching. See lib/changestats.zsh for the semantics.
#
# A file with several owners is counted in full for each of them, because each
# one is separately on the hook for reviewing it. Team rows therefore overlap
# and can sum to more than the TOTAL row. TOTAL counts each line exactly once
# and reconciles with `git diff --numstat`.
#
# Usage: teamdiffstats [from_ref] [to_ref]

emulate -L zsh
setopt extended_glob

from_ref=${1:-origin/main}
to_ref=${2:---staged}

_lib=${0:A:h}/lib/changestats.zsh
if [[ ! -r $_lib ]]; then
  print -u2 "teamdiffstats: missing library at $_lib"
  exit 1
fi
source $_lib

UNOWNED="(unowned)"
TOTAL_LABEL="TOTAL (each line once)"

# One column per credited class, in report order. `generated` is reported by
# diffstats but carries no authorship credit, so it has no column and no team.
# `support` does: a human wrote the story or the string catalogue, and the owning
# team is still on the hook for it. It gets its own column rather than being
# folded into Code, because a team whose whole share is support scaffolding has a
# much smaller reading job than the line count suggests.
typeset -a CLASSES=(code test support)
typeset -A CLASS_LABEL=(code "Code" test "Tests" support "Support")

codeowners_load .github/CODEOWNERS

# Keyed "<class>|<team>". One flat pair of maps rather than a pair per class, so
# adding a class is a CLASSES entry and nothing else. Keys are built into a
# variable first: an associative subscript inside (( )) is read as arithmetic,
# and `|` there is bitwise-or, not a separator.
typeset -A add del
typeset -A tot_add tot_del
typeset -A seen_team
for c in $CLASSES; do tot_add[$c]=0 tot_del[$c]=0; done

_bump() {  # _bump <team> <class> <added> <deleted>
  local t=$1 c=$2 k
  local -i a=$3 d=$4
  k="$c|$t"
  add[$k]=$(( ${add[$k]:-0} + a ))
  del[$k]=$(( ${del[$k]:-0} + d ))
  # Ensure the team appears even if its only lines are in another class.
  seen_team[$t]=1
  local other
  for other in $CLASSES; do
    k="$other|$t"
    : ${add[$k]=0} ${del[$k]=0}
  done
}

while read -r added deleted file; do
  [[ -z $file ]] && continue
  # Binary files report "-" for both counts.
  [[ $added == '-' || $deleted == '-' ]] && continue

  kind=$(classify_path $file)
  [[ $kind == generated ]] && continue

  tot_add[$kind]=$(( ${tot_add[$kind]:-0} + added ))
  tot_del[$kind]=$(( ${tot_del[$kind]:-0} + deleted ))

  owners=($(codeowners_for $file))
  if (( ${#owners} == 0 )); then
    _bump $UNOWNED $kind $added $deleted
  else
    for owner in $owners; do
      _bump ${owner#@} $kind $added $deleted
    done
  fi
done < <(git diff "$from_ref" "$to_ref" --numstat)

# Nothing to report. Callers (the prepare-commit-msg hook) treat empty output as
# "skip the stats block".
(( ${#seen_team} )) || exit 0

# --- ordering: teams by total lines touched, descending; unowned last --------
_team_total() {  # _team_total <team>
  local t=$1 c k
  local -i sum=0
  for c in $CLASSES; do
    k="$c|$t"
    (( sum += ${add[$k]:-0} + ${del[$k]:-0} ))
  done
  print $sum
}

typeset -a ordered
for t in ${(k)seen_team}; do
  [[ $t == $UNOWNED ]] && continue
  ordered+=("$(_team_total $t)	$t")
done
ordered=(${(f)"$(print -rl -- $ordered | sort -t$'\t' -k1,1nr -k2,2)"})
typeset -a teams
for row in $ordered; do
  [[ -n $row ]] && teams+=("${row#*$'\t'}")
done
(( ${+seen_team[$UNOWNED]} )) && teams+=("$UNOWNED")

# --- column widths ----------------------------------------------------------
_fmt_pair() {  # _fmt_pair <added> <deleted> <addw> <delw>
  printf "(%+*d, %*d)" $3 $1 $4 $(( -$2 ))
}

typeset -i w_team=${#TOTAL_LABEL}
for t in $teams; do
  (( ${#t} > w_team )) && w_team=${#t}
done

_w() {  # widest formatted integer across the values given
  local -i m=1 v
  for v in $@; do (( ${#v} > m )) && m=${#v}; done
  print $m
}

# Per class: added width, deleted width, and the total column width the pair
# renders to. +1 in every number column leaves room for the sign printf adds
# ('+' on additions, '-' on deletions). Without it the rule line is shorter than
# the widest row.
typeset -A w_add w_del w_col
for c in $CLASSES; do
  typeset -a vals_a=() vals_d=()
  for t in $teams; do
    k="$c|$t"
    vals_a+=(${add[$k]:-0})
    vals_d+=(${del[$k]:-0})
  done
  w_add[$c]=$(( $(_w $vals_a ${tot_add[$c]}) + 1 ))
  w_del[$c]=$(( $(_w $vals_d ${tot_del[$c]}) + 1 ))
  w_col[$c]=$(( w_add[$c] + w_del[$c] + 4 ))
done

# --- render -----------------------------------------------------------------
_rule() {  # the "----  ----- -----" separator, one segment per class
  local -a segs
  local c
  local -i wc
  for c in $CLASSES; do
    wc=${w_col[$c]}
    segs+=("${(l:wc::-:)}")
  done
  _row "${(l:w_team::-:)}" $segs
}

_row() {  # _row <team-cell> <pre-formatted class cells...>
  local team=$1; shift
  printf "%-*s  %s\n" $w_team "$team" "${(j: :)@}"
}

_header() {
  local -a cells
  local c
  local -i wc
  for c in $CLASSES; do
    wc=${w_col[$c]}
    cells+=("$(printf "%-*s" $wc "${CLASS_LABEL[$c]}")")
  done
  _row "Team" $cells
}

_cells_for() {  # _cells_for <team>|--total
  local t=$1 c k
  local -a cells
  for c in $CLASSES; do
    if [[ $t == --total ]]; then
      cells+=("$(_fmt_pair ${tot_add[$c]} ${tot_del[$c]} ${w_add[$c]} ${w_del[$c]})")
    else
      k="$c|$t"
      cells+=("$(_fmt_pair ${add[$k]:-0} ${del[$k]:-0} ${w_add[$c]} ${w_del[$c]})")
    fi
  done
  print -rl -- $cells
}

_header
_rule

for t in $teams; do
  _row "$t" ${(f)"$(_cells_for $t)"}
done

_rule
_row "$TOTAL_LABEL" ${(f)"$(_cells_for --total)"}

# Only worth saying when it can actually be observed.
if (( ${#teams} > 1 )); then
  print -r -- ""
  print -r -- "A file with several owners counts for each of them, so team rows can exceed TOTAL."
fi

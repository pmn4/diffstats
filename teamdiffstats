#!/bin/zsh
# teamdiffstats - git diff statistics grouped by CODEOWNERS team.
#
# PURPOSE
# When GitHub lists a team as a required reviewer on a PR, that team should be
# able to find its own row here and see how much of the diff belongs to it.
# So the set of team rows is built to equal GitHub's required-reviewer set:
# last-matching-rule-wins, every owner on the winning rule credited, gitignore
# path-component matching. See lib/changestats.zsh for the semantics.
#
# A file with several owners is counted in full for each of them, because each
# one is separately on the hook for reviewing it. Team rows therefore overlap
# and can sum to more than the TOTAL row. TOTAL counts each line exactly once
# and reconciles with `git diff --numstat`.
#
# Usage: teamdiffstats [from_ref] [to_ref]

emulate -L zsh
setopt extended_glob

from_ref=${1:-origin/main}
to_ref=${2:---staged}

_lib=${0:A:h}/lib/changestats.zsh
if [[ ! -r $_lib ]]; then
  print -u2 "teamdiffstats: missing library at $_lib"
  exit 1
fi
source $_lib

UNOWNED="(unowned)"
TOTAL_LABEL="TOTAL (each line once)"

codeowners_load .github/CODEOWNERS

typeset -A code_add code_del test_add test_del
typeset -i tot_code_add=0 tot_code_del=0 tot_test_add=0 tot_test_del=0

_bump() {  # _bump <team> <kind> <added> <deleted>
  local t=$1 kind=$2
  local -i a=$3 d=$4
  if [[ $kind == test ]]; then
    (( test_add[$t] += a, test_del[$t] += d ))
  else
    (( code_add[$t] += a, code_del[$t] += d ))
  fi
  # Ensure the team appears even if its only lines are on the other axis.
  : ${code_add[$t]=0} ${code_del[$t]=0} ${test_add[$t]=0} ${test_del[$t]=0}
}

while read -r added deleted file; do
  [[ -z $file ]] && continue
  # Binary files report "-" for both counts.
  [[ $added == '-' || $deleted == '-' ]] && continue

  kind=$(classify_path $file)
  # `generated` is reported by diffstats but carries no authorship credit, so it
  # is excluded from team rows and from TOTAL here.
  [[ $kind == generated ]] && continue

  if [[ $kind == test ]]; then
    (( tot_test_add += added, tot_test_del += deleted ))
  else
    (( tot_code_add += added, tot_code_del += deleted ))
  fi

  owners=($(codeowners_for $file))
  if (( ${#owners} == 0 )); then
    _bump $UNOWNED $kind $added $deleted
  else
    for owner in $owners; do
      _bump ${owner#@} $kind $added $deleted
    done
  fi
done < <(git diff "$from_ref" "$to_ref" --numstat)

# Nothing to report. Callers (the prepare-commit-msg hook) treat empty output as
# "skip the stats block".
(( ${#code_add} )) || exit 0

# --- ordering: teams by total lines touched, descending; unowned last --------
typeset -a ordered
for t in ${(k)code_add}; do
  [[ $t == $UNOWNED ]] && continue
  ordered+=("$(( code_add[$t] + code_del[$t] + test_add[$t] + test_del[$t] ))	$t")
done
ordered=(${(f)"$(print -rl -- $ordered | sort -t$'\t' -k1,1nr -k2,2)"})
typeset -a teams
for row in $ordered; do teams+=("${row#*$'\t'}"); done
(( ${+code_add[$UNOWNED]} )) && teams+=("$UNOWNED")

# --- column widths ----------------------------------------------------------
_fmt_pair() {  # _fmt_pair <added> <deleted> <addw> <delw>
  printf "(%+*d, %*d)" $3 $1 $4 $(( -$2 ))
}

typeset -i w_team=${#TOTAL_LABEL} w_ca=1 w_cd=1 w_ta=1 w_td=1
for t in $teams; do
  (( ${#t} > w_team )) && w_team=${#t}
done
_w() {  # widest formatted integer across teams + total
  local -i m=1 v
  for v in $@; do (( ${#v} > m )) && m=${#v}; done
  print $m
}
w_ca=$(_w ${(v)code_add} $tot_code_add)
w_cd=$(_w ${(v)code_del} $tot_code_del)
w_ta=$(_w ${(v)test_add} $tot_test_add)
w_td=$(_w ${(v)test_del} $tot_test_del)
# +1 in every column leaves room for the sign printf adds ('+' on additions,
# '-' on deletions). Without it the rule line is shorter than the widest row.
(( w_ca++, w_ta++, w_cd++, w_td++ ))

typeset -i w_code=$(( w_ca + w_cd + 4 )) w_test=$(( w_ta + w_td + 4 ))

# --- render -----------------------------------------------------------------
printf "%-*s  %-*s %-*s\n" $w_team "Team" $w_code "Code" $w_test "Tests"
printf "%-*s  %-*s %-*s\n" \
  $w_team "${(l:w_team::-:)}" $w_code "${(l:w_code::-:)}" $w_test "${(l:w_test::-:)}"

for t in $teams; do
  printf "%-*s  %s %s\n" $w_team "$t" \
    "$(_fmt_pair ${code_add[$t]} ${code_del[$t]} $w_ca $w_cd)" \
    "$(_fmt_pair ${test_add[$t]} ${test_del[$t]} $w_ta $w_td)"
done

printf "%-*s  %-*s %-*s\n" \
  $w_team "${(l:w_team::-:)}" $w_code "${(l:w_code::-:)}" $w_test "${(l:w_test::-:)}"
printf "%-*s  %s %s\n" $w_team "$TOTAL_LABEL" \
  "$(_fmt_pair $tot_code_add $tot_code_del $w_ca $w_cd)" \
  "$(_fmt_pair $tot_test_add $tot_test_del $w_ta $w_td)"

# Only worth saying when it can actually be observed.
if (( ${#teams} > 1 )); then
  print -r -- ""
  print -r -- "A file with several owners counts for each of them, so team rows can exceed TOTAL."
fi

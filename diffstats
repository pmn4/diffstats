#!/bin/zsh
# diffstats - Visual git diff statistics
# Shows code, test, support, and generated changes with axis-aligned visual bars

from_ref=${1:-origin/main}
to_ref=${2:---staged}

# The code/test/support/generated split is shared with teamdiffstats. It used to
# be an inline regex duplicated in both scripts, and the copies drifted far
# enough to disagree on ~1,400 files.
_lib=${0:A:h}/lib/changestats.zsh
if [[ ! -r $_lib ]]; then
  print -u2 "diffstats: missing library at $_lib"
  exit 1
fi
source $_lib

# Emit "added <TAB> deleted <TAB> class" so awk only has to total and render.
_classified() {
  local added deleted file
  while read -r added deleted file; do
    [[ -z $file ]] && continue
    [[ $added == '-' || $deleted == '-' ]] && continue   # binary
    print -r -- "$added	$deleted	$(classify_path $file)"
  done < <(git diff "$from_ref" "$to_ref" --numstat)
}

# One row per class, driven by an array. The previous version hand-unrolled the
# same twelve lines once per class, so adding a fourth class meant a fourth copy.
_classified | awk '
BEGIN {
  add_char="█";
  del_char="▒";
  bar_width=10;
  # Report order. Cheapest-to-review last, so the eye lands on Code first.
  n = 4;
  class[1] = "code";      labels[1] = "Code";
  class[2] = "test";      labels[2] = "Tests";
  class[3] = "support";   labels[3] = "Support";
  class[4] = "generated"; labels[4] = "Generated";
  for (i = 1; i <= n; i++) { add[i] = 0; del[i] = 0; slot[class[i]] = i }
}
{
  # An unrecognised class reads as code, matching the fallback in classify_path:
  # if we cannot tell, assume a human has to read it.
  i = ($3 in slot) ? slot[$3] : slot["code"];
  add[i] += $1; del[i] += $2;
}
END {
  # Scale every bar against one range, so the rows are comparable to each other.
  max_add = 0; max_del = 0;
  for (i = 1; i <= n; i++) {
    if (add[i] > max_add) max_add = add[i];
    if (del[i] > max_del) max_del = del[i];
  }
  range = max_add + max_del;

  # Callers (the prepare-commit-msg hook) treat empty output as "skip the block".
  if (range == 0) exit 0;

  add_width = length(sprintf("%d", max_add));
  del_width = length(sprintf("%d", max_del));

  max_add_blocks = 0; max_del_blocks = 0;
  for (i = 1; i <= n; i++) {
    add_blocks[i] = int((add[i] * bar_width / range) + 0.5);
    del_blocks[i] = int((del[i] * bar_width / range) + 0.5);
    # A class with any change at all gets a visible block.
    if (add[i] > 0 && add_blocks[i] == 0) add_blocks[i] = 1;
    if (del[i] > 0 && del_blocks[i] == 0) del_blocks[i] = 1;
    if (add_blocks[i] > max_add_blocks) max_add_blocks = add_blocks[i];
    if (del_blocks[i] > max_del_blocks) max_del_blocks = del_blocks[i];
  }

  # Pad each bar so the additions/deletions boundary lands on one column.
  max_label_width = 0;
  for (i = 1; i <= n; i++)
    if (length(labels[i]) > max_label_width) max_label_width = length(labels[i]);
  max_label_width += 2; # for the bullet and space

  for (i = 1; i <= n; i++) {
    bar = "";
    for (j = max_add_blocks - add_blocks[i]; j > 0; j--) bar = bar " ";
    for (j = 0; j < add_blocks[i]; j++) bar = bar add_char;
    for (j = 0; j < del_blocks[i]; j++) bar = bar del_char;
    for (j = max_del_blocks - del_blocks[i]; j > 0; j--) bar = bar " ";
    printf("• %-*s%s (%+*d, %*d)\n", max_label_width, labels[i], bar,
           add_width+1, add[i], del_width+1, -1 * del[i]);
  }
}' from_ref="$from_ref" to_ref="$to_ref"